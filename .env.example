# HeyBar environment template — placeholders only. Never commit real secrets.
# Copy to `.env.local` for local Next.js. Stubs work without owner credentials.
# On Vercel: set these in Project → Settings → Environment Variables
# (Preview + Production). Owner fills real values when projects exist.

# ---------------------------------------------------------------------------
# Runtime / hosting (usually auto-set by Vercel — document only)
# ---------------------------------------------------------------------------
# VERCEL=1
# VERCEL_ENV=preview|production|development
# VERCEL_URL=<deployment-host>          # e.g. heybar-git-….vercel.app
# NEXT_PUBLIC_VERCEL_URL=               # optional public mirror of host

# ---------------------------------------------------------------------------
# Auth — STUB today (methods OPEN). Placeholders for future provider wiring.
# Do not invent a live auth flow until OPEN A3 is decided.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_AUTH_PROVIDER=            # OPEN — e.g. supabase | … (unset = stub)
# AUTH_SECRET=                          # session signing secret (owner-only when live)

# ---------------------------------------------------------------------------
# Supabase — PLACEHOLDERS until James creates the project (owner-only keys).
# Placeholder markers keep stub mode (see src/lib/supabase/env.ts).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the browser or NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Payment adapter — STUB (provider OPEN). HMAC for signed webhook stub only.
# Replace when a real gateway is chosen; checkoutUrl stays null until then.
# ---------------------------------------------------------------------------
HEYBAR_PAYMENT_STUB_SECRET=heybar-payment-stub-dev
# PAYMENT_PROVIDER=                     # OPEN — do not invent
# PAYMENT_WEBHOOK_SECRET=               # real provider webhook secret (owner-only)

# ---------------------------------------------------------------------------
# Delivery — STUB fees/territory OPEN. No env required today.
# ---------------------------------------------------------------------------
# DELIVERY_PROVIDER=                    # OPEN — model/provider unset

# ---------------------------------------------------------------------------
# Notifications — interface TBD (channels OPEN). No env required today.
# ---------------------------------------------------------------------------
# NOTIFICATION_CHANNEL=                 # OPEN — push | sms | email | …

# ---------------------------------------------------------------------------
# E2E / PWA smoke (local + any Vercel preview URL)
# ---------------------------------------------------------------------------
# Playwright default base (e2e/*.spec.ts)
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PWA install smoke script (scripts/pwa-smoke.mjs) — override for preview:
#   BASE_URL=https://<preview>.vercel.app EXPECT_SW=1 npm run test:pwa-smoke
BASE_URL=http://127.0.0.1:3000
# Set EXPECT_SW=1 against production builds / Vercel previews (SW disabled in `next dev`)
EXPECT_SW=0
