# HeyBar env template — placeholders only. Never commit real secrets.
# Copy to `.env.local` for local Next.js. Owner fills real values when
# Vercel / Supabase projects exist.

# ---------------------------------------------------------------------------
# Supabase (public — safe for browser when real; placeholders keep stub mode)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the client / NEXT_PUBLIC_*.
# Used by migrations tooling / privileged API routes once a project exists.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

